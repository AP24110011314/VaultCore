# ==============================================================================
# VaultCore - .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Gradle Build & Cache Artifacts
# ------------------------------------------------------------------------------
.gradle/
build/
out/
bin/
.gradletasknamecache

# Keep gradle-wrapper jar and source builds
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# ------------------------------------------------------------------------------
# 2. Java / JVM Compiled Files & Crash Logs
# ------------------------------------------------------------------------------
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 3. IDEs & Editors
# ------------------------------------------------------------------------------
# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
cmake-build-*/

# Visual Studio Code
.vscode/
*.code-workspace
.history/

# Eclipse / Spring Tool Suite (STS)
.apt_generated
.apt_generated_tests
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbproject/load-impl.xml
/nbproject/copylib-libraries.properties

# Vim / Emacs / Sublime / JetBrains swap & temporary files
*.swp
*.swo
*~
*.bak
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 4. Logs & Runtime Files
# ------------------------------------------------------------------------------
*.log
*.log.*
logs/

# ------------------------------------------------------------------------------
# 5. Local Environment, Secrets & Overrides (DO NOT COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
application-local.yml
application-local.properties
application-dev-local.yml
secrets.yml
secrets.properties
*.pem
*.key
*.jks
*.p12

# ------------------------------------------------------------------------------
# 6. Docker & Local Database Mounts
# ------------------------------------------------------------------------------
docker-compose.override.yml
postgres_data/
*.dump
*.sql.gz

# ------------------------------------------------------------------------------
# 7. Documentation
# ------------------------------------------------------------------------------
docs/
doc/

# ------------------------------------------------------------------------------
# 8. Operating System Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
